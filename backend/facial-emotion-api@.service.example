[Unit]
Description=Facial Emotion Recognition API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/facial-recognition/backend
EnvironmentFile=%h/facial-recognition/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/facial-recognition/backend/.venv/bin/python %h/facial-recognition/backend/run.py
Restart=on-failure
RestartSec=5
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
